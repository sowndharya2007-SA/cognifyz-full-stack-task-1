<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Connect | Full Stack Portal</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <main class="page">

        <section class="hero">

            <div class="hero-content">

                <span class="badge">FULL-STACK DEVELOPMENT</span>

                <h1>
                    Let's build something
                    <span>meaningful.</span>
                </h1>

                <p>
                    A modern server-rendered contact portal built with
                    Node.js, Express and EJS.
                </p>

                <div class="tech-stack">
                    <span>HTML</span>
                    <span>Express</span>
                    <span>EJS</span>
                    <span>Node.js</span>
                </div>

            </div>

        </section>


        <section class="form-section">

            <div class="form-card">

                <% if (submitted) { %>

                    <div class="success-box">

                        <div class="success-icon">✓</div>

                        <h2>Message received!</h2>

                        <p>
                            Thanks, <strong><%= user.name %></strong>.
                            Your message has been successfully processed
                            by the server.
                        </p>

                        <div class="submitted-data">

                            <div>
                                <small>Email</small>
                                <p><%= user.email %></p>
                            </div>

                            <div>
                                <small>Message</small>
                                <p><%= user.message %></p>
                            </div>

                        </div>

                        <a href="/" class="secondary-button">
                            Send another message
                        </a>

                    </div>

                <% } else { %>

                    <div class="form-header">

                        <span class="form-number">01</span>

                        <div>
                            <h2>Start a conversation</h2>
                            <p>Tell us a little about yourself.</p>
                        </div>

                    </div>


                    <% if (error) { %>

                        <div class="error-box">
                            <span>!</span>
                            <%= error %>
                        </div>

                    <% } %>


                    <form action="/submit" method="POST">

                        <div class="input-group">

                            <label for="name">
                                Full Name
                            </label>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="Enter your name"
                                required
                            >

                        </div>


                        <div class="input-group">

                            <label for="email">
                                Email Address
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="you@example.com"
                                required
                            >

                        </div>


                        <div class="input-group">

                            <label for="message">
                                Message
                            </label>

                            <textarea
                                id="message"
                                name="message"
                                rows="5"
                                placeholder="Tell us what you'd like to build..."
                                required
                            ></textarea>

                        </div>


                        <button type="submit">
                            <span>Submit Message</span>
                            <span class="arrow">→</span>
                        </button>

                    </form>

                <% } %>

            </div>

        </section>

    </main>
    <script src="/script.js"></script>

</body>
</html>